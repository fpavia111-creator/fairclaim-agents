{
  "name": "fairclaim-charge-capture",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/fairclaim-charge-capture",
  "description": "Matches completed visits to charges: finds visits with no charge, charges with no visit or on a cancelled one, late charge entry, missing expected codes, and E/M level mix by provider against peers. Patient identifiers are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclaim-charge-capture": "bin/fairclaim-charge-capture.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclaim-charge-capture.js demo",
    "eval": "node bin/fairclaim-charge-capture.js eval"
  },
  "dependencies": {
    "fairclaim-core": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclaim-agents.git",
    "directory": "packages/fairclaim-charge-capture"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclaim-agents/tree/main/packages/fairclaim-charge-capture#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclaim-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "charge-capture",
    "charge-lag",
    "em-levels"
  ]
}
