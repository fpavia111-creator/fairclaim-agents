{
  "name": "borage-of-estimates",
  "version": "0.2.0",
  "description": "Keeps good faith estimates for self-pay and uninsured patients on time: counts business days from scheduling or request to each estimate's due date, finds missing and late estimates, compares final bills with estimates per provider against the 400-dollar dispute threshold, and drafts an estimate for a person to send. Patient identifiers are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "borage-of-estimates": "bin/borage-of-estimates.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/borage-of-estimates.js demo",
    "eval": "node bin/borage-of-estimates.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/remedy-agents.git",
    "directory": "packages/borage-of-estimates"
  },
  "homepage": "https://github.com/fpavia111-creator/remedy-agents/tree/main/packages/borage-of-estimates#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/remedy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "good-faith-estimate",
    "no-surprises-act",
    "self-pay",
    "price-estimate"
  ]
}
