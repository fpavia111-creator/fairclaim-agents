{
  "suite": "clover-of-charges",
  "root": "..",
  "data_note": "Fictional practice, providers and patients in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "reconcile", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config.json", "as_of": "2026-02-12"}, "expect": {"status": "executed", "equals": {"result.visits": 17, "result.charges_checked": 16, "result.need_action": 5, "result.by_status.pending": 1, "result.by_status.matched": 12, "result.items.0.appointment_id": "V103", "result.items.0.status": "missing_charge", "result.items.0.days_since": 7}}},
    {"id": "match-by-patient-and-date", "tool": "clover_explain", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12", "ref": "V108"}, "expect": {"equals": {"result.row.claim_id": "E-88", "result.row.status": "matched"}}},
    {"id": "no-show-charged", "tool": "clover_explain", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12", "ref": "V105"}, "expect": {"equals": {"result.row.status": "charge_on_cancelled"}, "contains": ["No Show"]}},
    {"id": "charge-without-visit", "tool": "clover_explain", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12", "ref": "W900"}, "expect": {"equals": {"result.row.status": "charge_without_visit"}}},
    {"id": "expected-code", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config.json", "as_of": "2026-02-12", "status": "expected_code_missing"}, "expect": {"equals": {"result.items.0.appointment_id": "V102"}, "contains": ["20610 or J*"]}},
    {"id": "no-config-no-expected-check", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12"}, "expect": {"not_contains": ["expected_code_missing"]}},
    {"id": "late-entry", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12", "status": "late_entry"}, "expect": {"equals": {"result.items.0.appointment_id": "V106", "result.items.0.entry_lag": 8}}},
    {"id": "em-mix", "tool": "clover_em_mix", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config.json"}, "expect": {"equals": {"result.providers.0.provider": "Alma Reyes MD (fictional)", "result.providers.0.level_4_5_share": 66.67, "result.providers.0.differs": true, "result.providers.2.differs": false}, "contains": ["not a finding"]}},
    {"id": "bad-config-refused", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config-typo.json"}, "expect": {"status": "error", "contains": ["/lag_days"]}},
    {"id": "names-masked", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\""], "not_contains": ["Pemberton", "Castellano"]}},
    {"id": "list-in-korean", "tool": "clover_write_report", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "as_of": "2026-02-12", "language": "ko", "out_dir": "remedy-out/eval-clover"}, "expect": {"status": "executed", "equals": {"result.lang": "ko"}}},
    {"id": "charge-post-refused", "tool": "charge_post", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id": "recall-empty-memory", "tool": "clover_recall", "args": {}, "expect": {"status": "executed", "contains": ["memory is empty", "visit_type_code"]}},
    {"id": "visit-done-no-charge", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config.json", "as_of": "2026-02-12", "status": "missing_charge"}, "expect": {"status": "executed", "length": {"result.items": 1}, "equals": {"result.items.0.appointment_id": "V103", "result.items.0.days_since": 7, "result.median_entry_lag": 1}, "contains": ["Ask the provider to close the note and enter the charge.", "Encounter ID"]}},
    {"id": "note-still-open-is-pending", "tool": "clover_reconcile", "args": {"appointments": "fixtures/appointments-2026-02.csv", "charges": "fixtures/exports/tebra-charges-2026-02.csv", "config": "fixtures/charge-config.json", "as_of": "2026-02-12", "status": "pending"}, "expect": {"length": {"result.items": 1}, "equals": {"result.items.0.status": "pending"}}}
  ]
}
