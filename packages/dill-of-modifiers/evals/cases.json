{
  "suite": "dill-of-modifiers",
  "root": "..",
  "data_note": "Fictional practice, payers and patients in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "check-837",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "config": "fixtures/modifier-config.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.claims": 10,
          "result.lines": 13,
          "result.clean_claims": 2,
          "result.errors": 4,
          "result.warnings": 6,
          "result.by_check.em_needs_25": 1,
          "result.items.0.claim_id": "D1002",
          "result.items.0.check": "needs_laterality"
        }
      }
    },
    {
      "id": "no-config-fewer-checks",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837"
      },
      "expect": {
        "not_contains": [
          "needs_laterality",
          "payer_not_accepted"
        ],
        "contains": [
          "wrong_code_25",
          "em_needs_25"
        ]
      }
    },
    {
      "id": "clean-claim",
      "tool": "dill_explain",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "config": "fixtures/modifier-config.json",
        "claim_id": "D1003"
      },
      "expect": {
        "equals": {
          "result.issues": []
        }
      }
    },
    {
      "id": "two-issues-one-line",
      "tool": "dill_explain",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "claim_id": "D1004"
      },
      "expect": {
        "equals": {
          "result.issues.0.check": "conflicting_pair",
          "result.issues.1.check": "distinct_redundant"
        }
      }
    },
    {
      "id": "export-layout",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/exports/advancedmd-charges.csv"
      },
      "expect": {
        "equals": {
          "result.claims": 2,
          "result.by_check.conflicting_pair": 1,
          "result.by_check.em_needs_25": 1
        }
      }
    },
    {
      "id": "lookup",
      "tool": "dill_modifier",
      "args": {
        "modifier": "xs"
      },
      "expect": {
        "equals": {
          "result.modifier": "XS",
          "result.kind": "info",
          "result.known": true
        }
      }
    },
    {
      "id": "lookup-unknown",
      "tool": "dill_modifier",
      "args": {
        "modifier": "ZZ"
      },
      "expect": {
        "equals": {
          "result.known": false
        }
      }
    },
    {
      "id": "bad-config-refused",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "config": "fixtures/modifier-config-typo.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "action"
        ]
      }
    },
    {
      "id": "names-masked",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837"
      },
      "expect": {
        "matches": [
          "\"patient_name\":\"PT-[0-9a-f]{8}\""
        ],
        "not_contains": [
          "OKAFOR",
          "Okafor",
          "LINDQVIST"
        ]
      }
    },
    {
      "id": "list-in-spanish",
      "tool": "dill_write_report",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "config": "fixtures/modifier-config.json",
        "language": "es",
        "out_dir": "remedy-out/eval-dill"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lang": "es"
        }
      }
    },
    {
      "id": "append-refused",
      "tool": "modifier_append",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "dill_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "payer_modifier_rule"
        ]
      }
    },
    {
      "id": "payer-wants-x-not-59",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "config": "fixtures/modifier-config.json",
        "check": "payer_not_accepted"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.items": 1
        },
        "equals": {
          "result.items.0.claim_id": "D1006",
          "result.items.0.source": "config"
        },
        "contains": [
          "does not accept 59: use XE, XS, XP or XU instead"
        ]
      }
    },
    {
      "id": "payment-modifier-first",
      "tool": "dill_explain",
      "args": {
        "claims": "fixtures/batch-2026-02-06.837",
        "claim_id": "D1009"
      },
      "expect": {
        "equals": {
          "result.issues.0.check": "pricing_order",
          "result.issues.0.severity": "warning"
        },
        "contains": [
          "26 (payment) comes after RT (informational)."
        ]
      }
    },
    {
      "id": "physical-status-is-pricing",
      "tool": "dill_modifier",
      "args": {
        "modifier": "p3"
      },
      "expect": {
        "equals": {
          "result.modifier": "P3",
          "result.kind": "pricing",
          "result.known": true
        },
        "contains": [
          "severe systemic disease"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "dill_check",
      "args": {
        "claims": "../../outside-root.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "dill_check",
      "args": {
        "claims": "fixtures/missing-export.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
