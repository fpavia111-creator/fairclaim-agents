  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclaim-revenue-kpis": "bin/fairclaim-revenue-kpis.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclaim-revenue-kpis.js demo",
    "eval": "node bin/fairclaim-revenue-kpis.js eval"
  },
  "dependencies": {
    "fairclaim-core": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclaim-agents.git",
    "directory": "packages/fairclaim-revenue-kpis"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclaim-agents/tree/main/packages/fairclaim-revenue-kpis#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclaim-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
