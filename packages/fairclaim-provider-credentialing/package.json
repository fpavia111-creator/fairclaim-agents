{
  "name": "fairclaim-provider-credentialing",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/fairclaim-provider-credentialing",
  "description": "Keeps provider credentialing and payer enrollment on track: license, DEA, board and malpractice expirations, CAQH re-attestation every 120 days, NPI check digits, enrollments pending too long, denied or not yet effective, and revalidation dates, with a work list and a calendar (.ics) of every due date.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclaim-provider-credentialing": "bin/fairclaim-provider-credentialing.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclaim-provider-credentialing.js demo",
    "eval": "node bin/fairclaim-provider-credentialing.js eval"
  },
  "dependencies": {
    "fairclaim-core": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclaim-agents.git",
    "directory": "packages/fairclaim-provider-credentialing"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclaim-agents/tree/main/packages/fairclaim-provider-credentialing#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclaim-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "credentialing",
    "enrollment",
    "caqh",
    "revalidation",
    "ics"
  ]
}
