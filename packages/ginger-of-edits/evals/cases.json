{
  "suite": "ginger-of-edits",
  "root": "..",
  "data_note": "Fictional practice and patients; illustrative NCCI rows (not the CMS edits) in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "totals", "tool": "ginger_check", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv"}, "expect": {"status": "executed", "equals": {"result.claims_checked": 11, "result.ptp_pairs": 6, "result.mue_codes": 4, "result.errors": 5, "result.warnings": 3, "result.at_risk_amount": 1035, "result.by_kind.ptp_no_modifier": 1, "result.by_kind.ptp_needs_modifier": 2, "result.by_kind.ptp_bypassed": 2, "result.by_kind.mue_day": 3}}},
    {"id": "deleted-and-indicator-9-ignored", "tool": "ginger_check", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv"}, "expect": {"not_contains": ["\"claim_id\":\"G1009\"", "\"claim_id\":\"G1010\""]}},
    {"id": "same-side-does-not-bypass", "tool": "ginger_explain", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "claim_id": "G1011"}, "expect": {"equals": {"result.findings.0.kind": "ptp_needs_modifier", "result.findings.0.column_1": "20610"}}},
    {"id": "mue-across-claims", "tool": "ginger_explain", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv", "claim_id": "G1008"}, "expect": {"equals": {"result.findings.0.kind": "mue_day", "result.findings.0.units": 2, "result.findings.0.mai": 2}}},
    {"id": "clinical-mue-is-a-warning", "tool": "ginger_explain", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv", "claim_id": "G1005"}, "expect": {"equals": {"result.findings.0.severity": "warning", "result.findings.0.mue": 4}}},
    {"id": "lookup-either-order", "tool": "ginger_lookup", "args": {"ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv", "code_1": "11042", "code_2": "11043", "date": "2026-01-15"}, "expect": {"equals": {"result.edits.0.column_1": "11043", "result.edits.0.deletion": "2025-12-31", "result.edits.0.active_on_date": false}}},
    {"id": "report-in-japanese", "tool": "ginger_write_report", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv", "language": "ja", "out_dir": "remedy-out/eval-ginger"}, "expect": {"status": "executed", "equals": {"result.lang": "ja"}}},
    {"id": "names-masked", "tool": "ginger_check", "args": {"claims": "fixtures/batch-ncci.837", "ptp": "fixtures/ncci-ptp-practitioner.csv", "mue": "fixtures/ncci-mue-practitioner.csv"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\""], "not_contains": ["ACHTERBERG", "SMI553209981"]}},
    {"id": "cannot-learn-a-bad-pair", "tool": "ginger_learn", "args": {"kind": "payer_pair_edit", "value": {"payer": "Sample Mutual Insurance", "column_1": "99396", "column_2": "1"}}, "expect": {"status": "error"}},
    {"id": "modifier-append-refused", "tool": "modifier_append", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id":"recall-empty-memory","tool":"ginger_recall","args":{},"expect":{"status":"executed","contains":["memory is empty","payer_pair_edit"]}}
  ]
}
