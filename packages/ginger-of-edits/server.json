{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/ginger-of-edits",
  "title": "Ginger of Edits",
  "description": "Ginger of Edits: checks claims against the CMS NCCI procedure-to-procedure edits and medically…",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/remedy-agents",
    "source": "github",
    "subfolder": "packages/ginger-of-edits"
  },
  "websiteUrl": "https://fair-agents.com/fairclaim.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "ginger-of-edits",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
