{
  "suite": "lovage-of-telehealth",
  "root": "..",
  "data_note": "Fictional practice, patients and example payer rules in ../fixtures (not any payer's policy). Deterministic checks; no model is called.",
  "cases": [
    {"id": "check", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json"}, "expect": {"status": "executed", "equals": {"result.lines_checked": 13, "result.telehealth_lines": 12, "result.errors": 7, "result.warnings": 2, "result.items.0.claim_id": "T9002"}}},
    {"id": "home-needs-pos-10", "tool": "lovage_explain", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "ref": "T9002"}, "expect": {"contains": ["place of service 10", "not 02"]}},
    {"id": "deleted-telephone-code", "tool": "lovage_explain", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "ref": "t9003"}, "expect": {"contains": ["99442 (telephone E/M, 11-20 minutes) was deleted", "does not cover audio-only visits"]}},
    {"id": "example-rule-labelled", "tool": "lovage_explain", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "ref": "T9004"}, "expect": {"contains": ["example rule", "Audio-only visit: add 93."]}},
    {"id": "license-follows-patient", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "check": "license"}, "expect": {"equals": {"result.items.0.claim_id": "T9006"}, "contains": ["not licensed in OR in your list (AK, WA)"]}},
    {"id": "same-day-in-person", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "check": "same_day"}, "expect": {"equals": {"result.items.0.claim_id": "T9008"}, "contains": ["in-person visit (T9009)"]}},
    {"id": "telemedicine-codes-by-payer", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "check": "payer_code"}, "expect": {"equals": {"result.items.0.claim_id": "T9005"}, "contains": ["does not take the 98000-98015 telemedicine codes"]}},
    {"id": "rules-listed", "tool": "lovage_rules", "args": {"config": "fixtures/telehealth-config.json"}, "expect": {"contains": ["3 payer rule(s) from your config", "the example rule (not any payer's policy)"]}},
    {"id": "bad-config-refused", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config-typo.json"}, "expect": {"status": "error", "contains": ["modifier"]}},
    {"id": "names-masked", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\""], "not_contains": ["Halvorsen", "DMP000799001", "1995-04-25", "Pemberton"]}},
    {"id": "report-in-japanese", "tool": "lovage_write_report", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "language": "ja", "out_dir": "remedy-out/eval-lovage"}, "expect": {"status": "executed", "equals": {"result.lang": "ja"}}},
    {"id": "visit-start-refused", "tool": "visit_start", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id": "recall-empty-memory", "tool": "lovage_recall", "args": {}, "expect": {"status": "executed", "contains": ["memory is empty", "payer_telehealth_rule"]}},
    {"id": "originating-site-fee-at-home", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "check": "originating_site"}, "expect": {"status": "executed", "length": {"result.items": 1}, "equals": {"result.items.0.claim_id": "T9010", "result.items.0.code": "Q3014"}, "contains": ["billed by the facility where the patient is, not for a patient at home"]}},
    {"id": "consent-code-needs-consent", "tool": "lovage_check", "args": {"visits": "fixtures/telehealth-visits-2026-02.csv", "config": "fixtures/telehealth-config.json", "check": "consent"}, "expect": {"length": {"result.items": 1}, "equals": {"result.items.0.claim_id": "T9007", "result.items.0.status": "warning"}, "contains": ["98016 needs the patient's consent documented"], "not_contains": ["Audio-only visit: add 93"]}}
  ]
}
