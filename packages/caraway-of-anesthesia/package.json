    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "caraway-of-anesthesia": "bin/caraway-of-anesthesia.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/caraway-of-anesthesia.js demo",
    "eval": "node bin/caraway-of-anesthesia.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
