    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "angelica-of-prices": "bin/angelica-of-prices.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/angelica-of-prices.js demo",
    "eval": "node bin/angelica-of-prices.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/remedy-agents.git",
