{
  "name": "angelica-of-prices",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/angelica-of-prices",
  "description": "Hospital price transparency without the fines: checks a machine-readable file against the CMS v3.0 tall CSV template (headers, attestation, code pairs, the twelve conditional rules), compares it with the chargemaster, and computes the median, 10th and 90th percentile allowed amounts and counts from 835s the CMS way.",
