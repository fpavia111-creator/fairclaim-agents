{
  "name": "fairclaim-credit-balances",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/fairclaim-credit-balances",
  "description": "Works the credit balance report: tells patient credits from payer overpayments, counts days against each payer's refund deadline (60 days from identification for Medicare by default), finds credits that should go to an open balance first or are nearing unclaimed-property age, and drafts each refund for a person to approve. Patient identifiers are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclaim-credit-balances": "bin/fairclaim-credit-balances.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclaim-credit-balances.js demo",
    "eval": "node bin/fairclaim-credit-balances.js eval"
  },
  "dependencies": {
    "fairclaim-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclaim-agents.git",
    "directory": "packages/fairclaim-credit-balances"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclaim-agents/tree/main/packages/fairclaim-credit-balances#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclaim-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "credit-balances",
    "refunds",
    "overpayments",
    "unclaimed-property"
  ]
}
