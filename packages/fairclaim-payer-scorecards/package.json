{
  "name": "fairclaim-payer-scorecards",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/fairclaim-payer-scorecards",
  "description": "Scores each payer from your 835s and claim submissions: days to pay, denial rate and top denial reasons, share of billed paid, reversals, and a month-by-month trend, against your targets. Patient identifiers are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclaim-payer-scorecards": "bin/fairclaim-payer-scorecards.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclaim-payer-scorecards.js demo",
    "eval": "node bin/fairclaim-payer-scorecards.js eval"
  },
  "dependencies": {
    "fairclaim-core": "^0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclaim-agents.git",
    "directory": "packages/fairclaim-payer-scorecards"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclaim-agents/tree/main/packages/fairclaim-payer-scorecards#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclaim-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "payer-scorecard",
    "days-to-pay",
    "denial-rate"
  ]
}
