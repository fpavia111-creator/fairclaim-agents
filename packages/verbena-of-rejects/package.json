{
  "name": "verbena-of-rejects",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/verbena-of-rejects",
  "description": "Verbena of Rejects: reads 999 and 277CA acknowledgements, ties each syntax error to the claim and segment in the 837 you sent, lists front-end rejections with what to fix, and flags claims that were never acknowledged.",
