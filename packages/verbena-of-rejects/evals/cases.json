{
  "suite": "verbena-of-rejects",
  "root": "..",
  "data_note": "Fictional practice, payers and patients in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "totals", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12"], "claims": "fixtures/batch-2026-01-20.837"}, "expect": {"status": "executed", "equals": {"result.transactions": 2, "result.transactions_rejected": 1, "result.claims_sent": 7, "result.claims_rejected": 4, "result.charges_rejected": 690, "result.not_acknowledged": 1}}},
    {"id": "999-error-tied-to-claim", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12"], "claims": "fixtures/batch-2026-01-20.837"}, "expect": {"equals": {"result.items.0.claim_id": "V1002", "result.items.0.scope": "claim", "result.items.0.loop": "2010BA", "result.items.0.severity": "warning"}}},
    {"id": "billing-provider-error-hits-every-claim", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12"], "claims": "fixtures/batch-2026-01-20.837"}, "expect": {"equals": {"result.items.1.claim_id": "V1005", "result.items.1.scope": "billing_provider", "result.items.2.claim_id": "V1006", "result.items.2.position": 6}}},
    {"id": "277ca-rejections-explained", "tool": "verbena_explain", "args": {"acks": ["fixtures/ack-277ca.x12"], "claim_id": "V1003"}, "expect": {"equals": {"result.items.0.codes": ["A7:562:82"], "result.items.0.category": "A7"}, "contains": ["rendering provider", "new original claim"]}},
    {"id": "without-the-837", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12"]}, "expect": {"equals": {"result.claims_sent": 0, "result.claims_rejected": 2, "result.charges_rejected": 280, "result.not_acknowledged": 0}}},
    {"id": "code-lookup", "tool": "verbena_codes", "args": {"list": "ik4", "code": "8"}, "expect": {"equals": {"result.meaning": "Invalid date"}}},
    {"id": "names-masked", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12"], "claims": "fixtures/batch-2026-01-20.837"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\""], "not_contains": ["CASTELLANO", "DMP000781234"]}},
    {"id": "report-in-french", "tool": "verbena_write_report", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12"], "claims": "fixtures/batch-2026-01-20.837", "language": "fr", "out_dir": "remedy-out/eval-verbena"}, "expect": {"status": "executed", "equals": {"result.lang": "fr"}}},
    {"id": "not-x12-refused", "tool": "verbena_rejections", "args": {"acks": ["fixtures/README.md"]}, "expect": {"status": "error", "contains": ["not an X12 file"]}},
    {"id": "resubmit-refused", "tool": "claim_resubmit", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id": "recall-empty-memory", "tool": "verbena_recall", "args": {}, "expect": {"status": "executed", "contains": ["memory is empty", "rejection_fix"]}},
    {"id": "resent-and-accepted-drops-off", "tool": "verbena_rejections", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12", "fixtures/ack-277ca-resent.x12"], "claims": "fixtures/batch-2026-01-20.837"}, "expect": {"status": "executed", "equals": {"result.claims_rejected": 3, "result.charges_rejected": 610, "result.resolved_by_later_acceptance": 1, "result.by_source.277CA": 1}, "not_contains": ["\"claim_id\":\"V1003\""]}},
    {"id": "missing-member-number", "tool": "verbena_explain", "args": {"acks": ["fixtures/ack-277ca.x12"], "claim_id": "V1007"}, "expect": {"equals": {"result.items.0.category": "A6", "result.items.0.severity": "error"}, "contains": ["contract or member number (subscriber)", "add it and resend as a new original claim"]}},
    {"id": "no-277ca-ask-the-clearinghouse", "tool": "verbena_explain", "args": {"acks": ["fixtures/ack-999.x12", "fixtures/ack-277ca.x12"], "claims": "fixtures/batch-2026-01-20.837", "claim_id": "V1004"}, "expect": {"equals": {"result.items.0.source": "none", "result.items.0.severity": "warning"}, "contains": ["ask whether the payer received it"]}},
    {"id": "status-and-entity-codes", "tool": "verbena_codes", "args": {"list": "status", "code": "562"}, "expect": {"equals": {"result.meaning": "Entity's National Provider Identifier (NPI)"}, "contains": ["not the official text"]}}
  ]
}
