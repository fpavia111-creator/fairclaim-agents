{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/hyssop-of-fees",
  "title": "Hyssop of Fees",
  "description": "Prices each code on your fee schedule from the Medicare RVU and GPCI files (RVU x GPCI x…",
  "version": "0.2.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/remedy-agents",
    "source": "github",
    "subfolder": "packages/hyssop-of-fees"
  },
  "websiteUrl": "https://fair-agents.com/fairclaim.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "hyssop-of-fees",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
