{
  "name": "hyssop-of-fees",
  "version": "0.2.0",
  "description": "Prices each code on your fee schedule from the Medicare RVU and GPCI files (RVU x GPCI x conversion factor), finds fees below what payers would allow (money left on the table when payers pay the lesser of charge or allowed), below your target percent of Medicare, or with no Medicare price, and drafts a fee update for a person to approve.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "hyssop-of-fees": "bin/hyssop-of-fees.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/hyssop-of-fees.js demo",
    "eval": "node bin/hyssop-of-fees.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/remedy-agents.git",
    "directory": "packages/hyssop-of-fees"
  },
  "homepage": "https://github.com/fpavia111-creator/remedy-agents/tree/main/packages/hyssop-of-fees#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/remedy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "fee-schedule",
    "chargemaster",
    "rvu",
    "gpci",
    "pfs"
  ]
}
