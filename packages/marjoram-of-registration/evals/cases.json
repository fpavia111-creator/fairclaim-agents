{
  "suite": "marjoram-of-registration",
  "root": "..",
  "data_note": "Fictional practice, payers and patients in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "check-all", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "config": "fixtures/registration-config.json", "as_of": "2026-02-15"}, "expect": {"status": "executed", "equals": {"result.patients": 11, "result.clean": 2, "result.errors": 7, "result.warnings": 8, "result.duplicate_pairs": 1, "result.by_check.mbi_format": 1, "result.by_check.member_id_pattern": 1, "result.items.0.severity": "error"}}},
    {"id": "dob-masked-in-messages", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "as_of": "2026-02-15", "check": "dob_future"}, "expect": {"contains": ["[DOB]"], "not_contains": ["2027-04-25", "04/25/2027"]}},
    {"id": "duplicates", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "as_of": "2026-02-15", "check": "possible_duplicate"}, "expect": {"equals": {"result.items.0.check": "possible_duplicate"}, "matches": ["Chart MRN-[0-9a-f]{8} has the same birth date"], "not_contains": ["Pembertin", "M-1101"]}},
    {"id": "no-config-no-pattern-checks", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "as_of": "2026-02-15"}, "expect": {"not_contains": ["mbi_format", "member_id_pattern"]}},
    {"id": "explain-by-pseudonym-or-raw", "tool": "marjoram_explain", "args": {"patients": "fixtures/registrations-2026-02.csv", "config": "fixtures/registration-config.json", "as_of": "2026-02-15", "mrn": "M-1006"}, "expect": {"equals": {"result.issues.0.check": "coverage_ended", "result.issues.1.check": "same_plan_twice"}}},
    {"id": "minor-guarantor", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "as_of": "2026-02-15", "check": "minor_no_guarantor"}, "expect": {"contains": ["Patient is 13"], "not_contains": ["Patient is -"]}},
    {"id": "bad-config-refused", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "config": "fixtures/registration-config-typo.json"}, "expect": {"status": "error", "contains": ["id_format"]}},
    {"id": "slow-pattern-refused", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "config": "fixtures/registration-config-redos.json"}, "expect": {"status": "error", "contains": ["may not repeat a group"]}},
    {"id": "names-masked", "tool": "marjoram_check", "args": {"patients": "fixtures/registrations-2026-02.csv", "as_of": "2026-02-15"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\"", "\"mrn\":\"MRN-[0-9a-f]{8}\""], "not_contains": ["Okafor", "Lindqvist", "907-555"]}},
    {"id": "list-in-chinese", "tool": "marjoram_write_report", "args": {"patients": "fixtures/registrations-2026-02.csv", "config": "fixtures/registration-config.json", "as_of": "2026-02-15", "language": "zh", "out_dir": "remedy-out/eval-marjoram"}, "expect": {"status": "executed", "equals": {"result.lang": "zh"}}},
    {"id": "merge-refused", "tool": "patient_merge", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id":"recall-empty-memory","tool":"marjoram_recall","args":{},"expect":{"status":"executed","contains":["memory is empty","payer_member_id_pattern"]}}
  ]
}
