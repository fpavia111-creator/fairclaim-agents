{
  "name": "mint-of-authorizations",
  "version": "0.2.0",
  "mcpName": "io.github.fpavia111-creator/mint-of-authorizations",
  "description": "Mint of Authorizations: matches claims or scheduled services to your prior-authorization log and 278 responses, and flags services with no authorization, expired or not-yet-valid dates, codes not on the authorization, units used up, pended or denied reviews, and authorizations about to run out.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "mint-of-authorizations": "bin/mint-of-authorizations.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/mint-of-authorizations.js demo",
    "eval": "node bin/mint-of-authorizations.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/remedy-agents.git",
    "directory": "packages/mint-of-authorizations"
  },
  "homepage": "https://github.com/fpavia111-creator/remedy-agents/tree/main/packages/mint-of-authorizations#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/remedy-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "medical-billing",
    "revenue-cycle",
    "healthcare",
    "remedy",
    "prior-authorization",
    "278",
    "utilization-review"
  ]
}
