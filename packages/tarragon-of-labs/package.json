{
  "name": "tarragon-of-labs",
  "version": "0.1.0",
  "description": "Lab claims that get paid: checks the CLIA number and certificate (QW on waived tests, nothing outside a waiver), finds panel components billed one by one or with their panel, venipuncture more than once a day, repeats without 91, diagnoses that do not support a test, and tests ordered more often than your rules allow.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tarragon-of-labs": "bin/tarragon-of-labs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/tarragon-of-labs.js demo",
    "eval": "node bin/tarragon-of-labs.js eval"
  },
  "dependencies": {
    "remedy-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/remedy-agents.git",
    "directory": "packages/tarragon-of-labs"
  },
  "homepage": "https://github.com/fpavia111-creator/remedy-agents/tree/main/packages/tarragon-of-labs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/remedy-agents/issues"
  },
  "keywords": [
    "mcp",
