{
  "suite": "nettle-of-audits",
  "root": "..",
  "data_note": "Fictional practice, patients and audit results in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {"id": "sample-is-reproducible", "tool": "nettle_sample", "args": {"charges": "fixtures/charges-2026-q1.csv", "config": "fixtures/audit-config.json", "seed": "q1-2026"}, "expect": {"status": "executed", "equals": {"result.lines_in_period": 32, "result.sampled": 20, "result.providers.0.focus": 2, "result.providers.1.focus": 3, "result.items.0.claim_id": "N2007", "result.items.1.claim_id": "N2012"}}},
    {"id": "sample-short-provider", "tool": "nettle_sample", "args": {"charges": "fixtures/charges-2026-q1.csv", "seed": "q1-2026", "em_only": true}, "expect": {"equals": {"result.sampled": 25, "result.providers.2.short": true}, "contains": ["fewer lines than asked for: Ines Moreau NP (fictional)"]}},
    {"id": "score", "tool": "nettle_score", "args": {"results": "fixtures/audit-results-2026-q1.csv", "config": "fixtures/audit-config.json"}, "expect": {"status": "executed", "equals": {"result.lines": 25, "result.accuracy": 64, "result.overpaid": 455, "result.underpaid": 55, "result.providers.0.accuracy": 40, "result.providers.0.pattern": "higher_levels", "result.providers.1.action": "too_few_lines", "result.items.0.outcome": "not_supported", "result.paid_overpayment": 335}}},
    {"id": "upcoded-detail", "tool": "nettle_score", "args": {"results": "fixtures/audit-results-2026-q1.csv", "outcome": "upcoded", "provider": "reyes"}, "expect": {"contains": ["Billed level 5 (99215); the record supports level 4 (99214)."]}},
    {"id": "explain-modifier", "tool": "nettle_explain", "args": {"results": "fixtures/audit-results-2026-q1.csv", "ref": "N2018"}, "expect": {"contains": ["modifier_error", "remove 25"]}},
    {"id": "bad-config-refused", "tool": "nettle_score", "args": {"results": "fixtures/audit-results-2026-q1.csv", "config": "fixtures/audit-config-typo.json"}, "expect": {"status": "error", "contains": ["accuracy_target"]}},
    {"id": "names-masked", "tool": "nettle_score", "args": {"results": "fixtures/audit-results-2026-q1.csv"}, "expect": {"matches": ["\"patient_name\":\"PT-[0-9a-f]{8}\""], "not_contains": ["Pemberton", "Thibodeaux"]}},
    {"id": "worksheet", "tool": "nettle_write_sample", "args": {"charges": "fixtures/charges-2026-q1.csv", "config": "fixtures/audit-config.json", "seed": "q1-2026", "out_dir": "remedy-out/eval-nettle"}, "expect": {"status": "executed", "equals": {"result.seed": "q1-2026"}, "contains": ["nettle-worksheet.csv"]}},
    {"id": "results-in-french", "tool": "nettle_write_report", "args": {"results": "fixtures/audit-results-2026-q1.csv", "config": "fixtures/audit-config.json", "language": "fr", "out_dir": "remedy-out/eval-nettle"}, "expect": {"status": "executed", "equals": {"result.lang": "fr"}}},
    {"id": "refund-refused", "tool": "refund_send", "args": {}, "expect": {"status": "blocked", "decision": "block"}},
    {"id":"recall-empty-memory","tool":"nettle_recall","args":{},"expect":{"status":"executed","contains":["memory is empty","focus_code"]}}
  ]
}
