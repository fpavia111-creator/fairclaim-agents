{
  "suite": "fairclaim-ncci-edits",
  "root": "..",
  "data_note": "Fictional practice and patients; illustrative NCCI rows (not the CMS edits) in ../fixtures. Deterministic checks; no model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "edits_check",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.claims_checked": 11,
          "result.ptp_pairs": 6,
          "result.mue_codes": 4,
          "result.errors": 5,
          "result.warnings": 3,
          "result.at_risk_amount": 1035,
          "result.by_kind.ptp_no_modifier": 1,
          "result.by_kind.ptp_needs_modifier": 2,
          "result.by_kind.ptp_bypassed": 2,
          "result.by_kind.mue_day": 3
        }
      }
    },
    {
      "id": "deleted-and-indicator-9-ignored",
      "tool": "edits_check",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv"
      },
      "expect": {
        "not_contains": [
          "\"claim_id\":\"G1009\"",
          "\"claim_id\":\"G1010\""
        ]
      }
    },
    {
      "id": "same-side-does-not-bypass",
      "tool": "edits_explain",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "claim_id": "G1011"
      },
      "expect": {
        "equals": {
          "result.findings.0.kind": "ptp_needs_modifier",
          "result.findings.0.column_1": "20610"
        }
      }
    },
    {
      "id": "mue-across-claims",
      "tool": "edits_explain",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv",
        "claim_id": "G1008"
      },
      "expect": {
        "equals": {
          "result.findings.0.kind": "mue_day",
          "result.findings.0.units": 2,
          "result.findings.0.mai": 2
        }
      }
    },
    {
      "id": "clinical-mue-is-a-warning",
      "tool": "edits_explain",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv",
        "claim_id": "G1005"
      },
      "expect": {
        "equals": {
          "result.findings.0.severity": "warning",
          "result.findings.0.mue": 4
        }
      }
    },
    {
      "id": "lookup-either-order",
      "tool": "edits_lookup",
      "args": {
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv",
        "code_1": "11042",
        "code_2": "11043",
        "date": "2026-01-15"
      },
      "expect": {
        "equals": {
          "result.edits.0.column_1": "11043",
          "result.edits.0.deletion": "2025-12-31",
          "result.edits.0.active_on_date": false
        }
      }
    },
    {
      "id": "report-in-japanese",
      "tool": "edits_write_report",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv",
        "language": "ja",
        "out_dir": "remedy-out/eval-edits"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.lang": "ja"
        }
      }
    },
    {
      "id": "names-masked",
      "tool": "edits_check",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv"
      },
      "expect": {
        "matches": [
          "\"patient_name\":\"PT-[0-9a-f]{8}\""
        ],
        "not_contains": [
          "ACHTERBERG",
          "SMI553209981"
        ]
      }
    },
    {
      "id": "cannot-learn-a-bad-pair",
      "tool": "edits_learn",
      "args": {
        "kind": "payer_pair_edit",
        "value": {
          "payer": "Sample Mutual Insurance",
          "column_1": "99396",
          "column_2": "1"
        }
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "modifier-append-refused",
      "tool": "modifier_append",
      "args": {},
      "expect": {
        "status": "blocked",
        "decision": "block"
      }
    },
    {
      "id": "recall-empty-memory",
      "tool": "edits_recall",
      "args": {},
      "expect": {
        "status": "executed",
        "contains": [
          "memory is empty",
          "payer_pair_edit"
        ]
      }
    },
    {
      "id": "indicator-0-never-payable",
      "tool": "edits_explain",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "claim_id": "G1003"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.findings.0.kind": "ptp_no_modifier",
          "result.findings.0.column_1": "93000",
          "result.findings.0.amount": 25
        },
        "contains": [
          "no modifier makes it payable",
          "Do not bill 93010 with 93000 on the same day"
        ]
      }
    },
    {
      "id": "lookup-active-pair-and-mue",
      "tool": "edits_lookup",
      "args": {
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv",
        "code_1": "99213",
        "code_2": "20610",
        "date": "2026-01-15"
      },
      "expect": {
        "equals": {
          "result.edits.0.column_1": "20610",
          "result.edits.0.modifier_indicator": "1",
          "result.edits.0.active_on_date": true,
          "result.mue.99213.mue": 1,
          "result.mue.20610.mai": 2
        },
        "contains": [
          "\"XS\"",
          "\"25\""
        ]
      }
    },
    {
      "id": "x-modifier-bypass-is-a-warning",
      "tool": "edits_explain",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "claim_id": "G1004"
      },
      "expect": {
        "equals": {
          "result.findings.0.kind": "ptp_bypassed",
          "result.findings.0.severity": "warning",
          "result.findings.0.modifiers": [
            "59"
          ]
        }
      }
    },
    {
      "id": "lookup-needs-both-codes",
      "tool": "edits_lookup",
      "args": {
        "ptp": "fixtures/ncci-ptp-practitioner.csv",
        "code_1": "93000"
      },
      "expect": {
        "status": "error",
        "contains": [
          "/code_2 is required"
        ]
      }
    },
    {
      "id": "file-outside-root-refused",
      "tool": "edits_check",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "../../outside-root.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside the allowed root"
        ]
      }
    },
    {
      "id": "missing-file-named",
      "tool": "edits_check",
      "args": {
        "claims": "fixtures/batch-ncci.837",
        "ptp": "fixtures/missing-export.csv",
        "mue": "fixtures/ncci-mue-practitioner.csv"
      },
      "expect": {
        "status": "error",
        "contains": [
          "not found",
          "missing-export.csv"
        ]
      }
    }
  ]
}
